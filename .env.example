# ─────────────────────────────────────────────────────────────
#  Pewee environment variables
#  `npm run setup` writes .env for you. To do it by hand, copy this
#  file to .env (or .env.local) and fill in the values.
#  Public branding lives in pewee.config.json, not here.
# ─────────────────────────────────────────────────────────────

# MongoDB connection string (MongoDB Atlas or self-hosted).
# Example (Atlas): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
# Example (local): mongodb://localhost:27017
MONGO_DB_URI=

# Database name to use on that server. Optional if the URI already names one.
DB_NAME=pewee

# Secret used to sign CMS login sessions. REQUIRED in production.
# Generate one with:  openssl rand -base64 32
JWT_SECRET=

# Optional: override the public site URL from pewee.config.json (e.g. for
# preview deployments). No trailing slash. Leave commented out normally.
# NEXT_PUBLIC_APP_URL=https://example.com

# Email of the CMS admin. Used as the default by `npm run create-admin`.
ADMIN_EMAIL=

# Optional: Google Analytics measurement ID (e.g. G-XXXXXXXXXX). Leave empty to disable.
NEXT_PUBLIC_GA_ID=
