# ─────────────────────────────────────────────────────────────
#  Pewee environment variables
#  Copy this file to .env (or .env.local) and fill in the values.
# ─────────────────────────────────────────────────────────────

# MongoDB connection string (MongoDB Atlas or self-hosted).
# Example (Atlas): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
# Example (local): mongodb://localhost:27017
MONGO_DB_URI=

# Database name to use on that server. Optional if the URI already names one.
DB_NAME=pewee

# Secret used to sign CMS login sessions. REQUIRED in production.
# Generate one with:  openssl rand -base64 32
JWT_SECRET=

# Public URL of your blog, no trailing slash. Used for canonical URLs,
# Open Graph tags, the sitemap and the RSS feed.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Google Analytics measurement ID (e.g. G-XXXXXXXXXX). Leave empty to disable.
NEXT_PUBLIC_GA_ID=
